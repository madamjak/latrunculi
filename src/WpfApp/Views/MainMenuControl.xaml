<UserControl x:Class="WpfApp.Views.MainMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="470" d:DesignWidth="740">

    <Grid  Margin="10,10,10,10" Background="DarkGray">

        
            <Grid.RowDefinitions>

            <RowDefinition Height="auto" MinHeight="100"/>
            <RowDefinition Height="auto" MinHeight="40"/>

            <RowDefinition Height="auto" MinHeight="40"/>

            <RowDefinition Height="auto" MinHeight="40"/>

            <RowDefinition Height="auto" MinHeight="40"/>

            <RowDefinition Height="auto" MinHeight="40"/>
            <RowDefinition Height="auto" MinHeight="40"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="700"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid>

            <Grid.RowDefinitions>


            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
                
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>


                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>

                </Grid.RowDefinitions>

                <TextBlock Margin="10,10, 10, 5" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontStyle="Italic" Text="The game played with many pieces is a board with spaces disposed among lines: " />
                <TextBlock Grid.Row="1" Margin="10,5, 10, 5" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontStyle="Italic" Text="the board is called the 'city' and each piece is called a 'dog';" />
                <TextBlock Grid.Row="2" Margin="10,5, 10, 5" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontStyle="Italic" Text="the pieces are of two colors, " />
                <TextBlock Grid.Row="3" Margin="10,5, 10, 10" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontStyle="Italic" Text="and the art of the game consists in taking a piece of one color by enclosing it between two of the other color." />
                

            </Grid>

            <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,10, 10, 10" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" FontStyle="Normal" Text="Julius Pollux, about Poleis game" />
        </Grid>
        
        
        
        
            <TextBlock Grid.Row="1" Margin="100,10" FontWeight="Bold" Text="Latrunculi game is similar...please choose your option..." />

        <Button Margin="100, 5" Padding="5"
                Grid.Row="2"
                Name="play"
                Content="Play game"
                Command="{Binding PlayGame}" />

        <Button Margin="100, 5" Padding="5"
                Grid.Row="3"
                Name="save"
                Content="Save game"
                Command="{Binding SaveGame}" />

        <Button Margin="100, 5" Padding="5"
                Grid.Row="4"
                Name="start"
                Content="Start new game"
                Command="{Binding StartNewGame}" />

        <Button Margin="100, 5" Padding="5"
                Grid.Row="5"
                Name="load"
                Content="Load existing game"
                Command="{Binding LoadExistingGame}" />

        <Button Margin="100, 5" Padding="5"
                 Grid.Row="6"
                Name="exit"
                Content="Exit"
                Command="{Binding Exit}" />
            
        </Grid>

</UserControl>
