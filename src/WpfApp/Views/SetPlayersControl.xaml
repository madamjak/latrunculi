<UserControl x:Class="WpfApp.Views.SetPlayersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views" xmlns:converters="clr-namespace:WpfApp.Converters" xmlns:viewmodels="clr-namespace:WpfApp.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SetPlayersViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="470" d:DesignWidth="740">
    <Control.Resources>
        <converters:EnumMatchToBooleanConverter x:Key="enumConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Control.Resources>

    <Grid  Margin="10,10,10,10" Background="DarkGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <Grid Margin="10, 10, 10, 10" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,10" FontWeight="Bold" Text="Please select black player type" />

                <RadioButton Grid.Row="1" Content="Human" GroupName="BPType" 
                 IsChecked="{Binding Path=BlackPlayerType, Mode=TwoWay, 
                                     Converter={StaticResource enumConverter},
                                     ConverterParameter=Human}"  />
                
                <RadioButton Grid.Row="2" Content="Computer" GroupName="BPType" 
                 IsChecked="{Binding Path=BlackPlayerType, Mode=TwoWay, 
                                     Converter={StaticResource enumConverter},
                                     ConverterParameter=Computer}"  />
                
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding BlackPlayerLevelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,10" FontWeight="Bold" Text="Please select CPU opponent difficulty" />
                <RadioButton Grid.Row="1" Content="Easy" GroupName="BPLevel" 
             IsChecked="{Binding Path=BlackPlayerLevel, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Easy}"  />
                <RadioButton Grid.Row="2" Content="Medium" GroupName="BPLevel" 
             IsChecked="{Binding Path=BlackPlayerLevel, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Medium}"  />
                <RadioButton Grid.Row="3" Content="Hard" GroupName="BPLevel" 
             IsChecked="{Binding Path=BlackPlayerLevel, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Hard}"  />
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="10, 10, 10, 10" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,10" FontWeight="Bold" Text="Please select white player type" />

                <RadioButton Grid.Row="1" Content="Human" GroupName="WPType" 
                 IsChecked="{Binding Path=WhitePlayerType, Mode=TwoWay, 
                                     Converter={StaticResource enumConverter},
                                     ConverterParameter=Human}"  />

                <RadioButton Grid.Row="2" Content="Computer" GroupName="WPType" 
                 IsChecked="{Binding Path=WhitePlayerType, Mode=TwoWay, 
                                     Converter={StaticResource enumConverter},
                                     ConverterParameter=Computer}"  />
                
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding WhitePlayerLevelVisible , Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,10" FontWeight="Bold" Text="Please select CPU opponent difficulty" />
                <RadioButton Grid.Row="1" Content="Easy" GroupName="WPLevel" 
             IsChecked="{Binding Path=WhitePlayerLevel, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Easy}"  />
                <RadioButton Grid.Row="2" Content="Medium" GroupName="WPLevel" 
             IsChecked="{Binding Path=WhitePlayerLevel, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Medium}"  />
                <RadioButton Grid.Row="3" Content="Hard" GroupName="WPLevel" 
             IsChecked="{Binding Path=WhitePlayerLevel, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Hard}"  />
            </Grid>
        </Grid>
        
        <Grid Grid.Row="1">
            <Button
            Content="Play"
            Command="{Binding PlayGame}" 
            VerticalAlignment="Top" Margin="10,10,10,10" Grid.Row="4" Height="auto" Width="auto" Padding="5"
                HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Button
            Content="To main menu"
            Command="{Binding MainMenu}"  Width="auto" HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="10,10,10,10" Grid.Row="4" Height="auto" Padding="5"/>
        </Grid>


    </Grid>


</UserControl>
