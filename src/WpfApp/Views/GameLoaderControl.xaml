<UserControl x:Class="WpfApp.Views.GameLoaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views" xmlns:viewmodels="clr-namespace:WpfApp.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:GameLoaderViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="470" d:DesignWidth="740">

    <Control.Resources >
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Control.Resources>

    <Grid Margin="10, 10, 10, 10" Background="DarkGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="Auto" MinHeight="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <TextBlock Margin="10,10" Grid.ColumnSpan="2" FontWeight="Bold" Text="{Binding UserMessage}" Foreground="DarkRed"></TextBlock>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"  Margin="10,10" FontWeight="Bold" Text="Please select file:" ></TextBlock>

        <TextBox Grid.Row="2" Grid.Column="0"  Margin="10,10" HorizontalAlignment="Stretch" Text="{Binding PathToFile}" Name="pathToFile"  />

        <Grid Grid.Row="2"  Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button  Margin="10, 10" Padding="5" HorizontalContentAlignment="Left" 
            Content="Browse"
            Click="Browse_save_click" 
            Visibility="{Binding SaveVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button Margin="10" Padding="5" HorizontalContentAlignment="Center" 
            Content="Browse"
            Click="Browse_load_click" 
            Visibility="{Binding LoadVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
        

        <Button Grid.Row="3" Grid.Column="0" Margin="10" Padding="5" HorizontalAlignment="Right"
            Content="Load"
            Command="{Binding Load}" 
            Visibility="{Binding LoadVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Button Grid.Row="3" Grid.Column="0" Margin="10" Padding="5" HorizontalAlignment="Right"
            Content="Save"
            Command="{Binding Save}" 
            Visibility="{Binding SaveVisible , Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Button Grid.Row="3" Grid.Column="1" Margin="10" Padding="5" HorizontalAlignment="Left"
            Content="To main menu"
            Command="{Binding MainMenu}" />
    </Grid>
</UserControl>
