<UserControl x:Class="WpfApp.Views.GameplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="470" d:DesignWidth="740"
             xmlns:viewmodels="clr-namespace:WpfApp.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:GamePlayViewModel}">

    <Control.Resources >
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Control.Resources>

    <Grid Margin="10, 10, 10, 10" Background="DarkGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="350" />
            <ColumnDefinition Width="*" MinWidth="350"/>
            
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto" MinHeight="50"/>
        </Grid.RowDefinitions>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="10,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="{Binding Model.GameplayUserMessage}" FontWeight="Bold" Foreground="DarkGreen"></TextBlock>

            <TextBlock Grid.Row="1" Margin="10,10" FontWeight="Bold" Text="{Binding Model.GameplayErrorMessage}" Foreground="DarkRed"></TextBlock>

            <Grid Grid.Row="2" Name="Board" Margin="10,10">
            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid Margin="10,10" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
            Content="Undo"
            Command="{Binding Undo}" />
                </Grid>

                <Grid Grid.Column="1" HorizontalAlignment="Center" >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
            Content="Redo"
            Command="{Binding Redo}" />
                </Grid>

                <Grid Grid.Column="2" HorizontalAlignment="Center" >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
            Content="{Binding Model.BestMoveButtonContent}"
            Command="{Binding BestMove}" />
                </Grid>



                <Grid Grid.Column="3" HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
            Content="Play"
            Command="{Binding Play}" />
                </Grid>

                <Grid Grid.Column="4" HorizontalAlignment="Center" >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
            Content="Pause"
            Command="{Binding Pause}" />
                </Grid>


            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"   Margin="10,10" FontWeight="Bold" Text="Number of moves without removed stone:" ></TextBlock>
                    <TextBlock Grid.Row="1"  Margin="10,10" Text="{Binding Model.NumberOfMovesWithoutRemovedStone}"></TextBlock>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"   Margin="10,10" FontWeight="Bold" Text="Black player:" ></TextBlock>
                    <TextBlock Grid.Row="1"  Margin="10,10" Text="{Binding Model.BlackPlayer.Type, StringFormat='Player type: {0}'}"></TextBlock>
                    <TextBlock Grid.Row="2"  Margin="10,10" Text="{Binding Model.BlackPlayer.Level , StringFormat='Player level: {0}'}" Visibility="{Binding Model.BlackLevelVisible, Converter={StaticResource BoolToVisibilityConverter}}"></TextBlock>
                    <TextBlock Grid.Row="3"  Margin="10,10" Text="{Binding Model.BlackPlayer.RemainingStones , StringFormat='Remaining pieces: {0}'}" ></TextBlock>
                </Grid>
                
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"   Margin="10,10" FontWeight="Bold" Text="White player:" ></TextBlock>
                    <TextBlock Grid.Row="1"   Margin="10,10" Text="{Binding Model.WhitePlayer.Type , StringFormat='Player type: {0}'}"></TextBlock>
                    <TextBlock Grid.Row="2"  Margin="10,10" Text="{Binding Model.WhitePlayer.Level , StringFormat='Player level: {0}'}" Visibility="{Binding Model.WhiteLevelVisible, Converter={StaticResource BoolToVisibilityConverter}}" ></TextBlock>
                    <TextBlock Grid.Row="3"  Margin="10,10" Text="{Binding Model.WhitePlayer.RemainingStones , StringFormat='Remaining pieces: {0}'}" ></TextBlock>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="10,10" >

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="5"
            Content="Edit players"
            Command="{Binding EditPlayers}"  />
                        </Grid>
                    </Grid>
                    
                </Grid>
                <Grid Grid.Row="2" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"   Margin="10,10" FontWeight="Bold" Text="History:" ></TextBlock>
                    <Grid Margin="10,10" Grid.Row="1" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid 
                AutoGenerateColumns="True"
                Name="dataGrid1" 
                          VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                ItemsSource="{Binding Model.MovesHistory}"
                />
                    </Grid>

                </Grid>
            </Grid>

            
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid Margin="10,10" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0" HorizontalAlignment="Left">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
                            Click="Lightbox_open"
            Content="Help"   />
                </Grid>

                <Grid Grid.Column="1" HorizontalAlignment="Right">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="5"
            Content="Main menu" 
            Command="{Binding MainMenu}"  />
                </Grid>


            </Grid>
        </Grid>

        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2">

            <Grid x:Name="Lightbox" Visibility="{Binding Model.HelpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Rectangle Fill="Black" Opacity=".6"/>
                <Border
                Margin="40"
                Background="SlateGray"
                BorderBrush="Black"
                BorderThickness="4"
                CornerRadius="20">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        
                                <TextBlock Margin="10">
  <Bold>Rules:</Bold><LineBreak/>
                            - each player has 16 pieces on board 8x7 <LineBreak/>
      - the pieces move forwards or backwards or sideways one square at a time <LineBreak/>
                            - a piece is captured when the opponent brackets it orthogonally between two of the opponent's pieces...<LineBreak/>
                            ...or between an opponent pieces in a corner square <LineBreak/>
                            - if a piece is moved voluntarily between two enemy pieces, it is not captured <LineBreak/>
                            - a player who loses all his pieces loses the game. <LineBreak/> 
                            - if no captures are made in thirty moves, the game is ended...<LineBreak/> 
                            ...and the player with more pieces on the board wins <LineBreak/>
                            <LineBreak/>
                            <Bold>Game control:</Bold><LineBreak/>
                            - pick a piece to move by left mouse click <LineBreak/>
      - game will show you valid moves you can make and you need to select some<LineBreak/>
                            - or you can also use 'Best move' option for best move calculated by CPU<LineBreak/>
                            - use 'Undo' / 'Redo' options to take move back<LineBreak/>
                            - 'Play' and 'Pause' options to be used to control autoplay when CPU plays for both players <LineBreak/>
                            - you can edit players any time

                                </TextBlock>
                        

                        <Grid  Grid.Row="1" HorizontalAlignment="Center" Margin="10">

                            <Button Padding="5"
            Content="Close"  Click="Lightbox_close" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>